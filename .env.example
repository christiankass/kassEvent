# Variables de docker-compose (ne jamais committer .env)
MINIO_ROOT_USER=kassevent
MINIO_ROOT_PASSWORD=change-moi

# PostgreSQL : superutilisateur d'administration, et mot de passe du rôle applicatif
# (DB_PASSWORD doit être identique à celui de backend/.env)
POSTGRES_PASSWORD=change-moi-aussi
DB_PASSWORD=secret
